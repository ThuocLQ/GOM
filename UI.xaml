<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivery Copy" Height="780" Width="1180" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
  <Window.Resources>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.10"/>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#0A7CFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0A7CFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0866D9"/><Setter TargetName="b" Property="BorderBrush" Value="#0866D9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#1F2937"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F5F6F8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#0A7CFF"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="#4B5563"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="33"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F3F5"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Delivery Copy" FontSize="24" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="Collect, review, and package files with an auditable delivery manifest." Margin="0,4,0,0" Foreground="#4B5563"/></StackPanel><Border Grid.Column="1" Background="#EAF3FF" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="InlineStatus" Text="Ready" Foreground="#0866D9"/></Border></Grid>
    <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
      <TabItem Header="1. Collect"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0">
        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Source and filters" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="SourcePath" Height="38" VerticalContentAlignment="Center" ToolTip="Repository or source folder"/><Button x:Name="ChooseSourceButton" Grid.Column="2" Content="▣  Choose folder" Style="{StaticResource SecondaryButton}"/></Grid><TextBox x:Name="ExcludeRules" Grid.Row="4" Height="38" VerticalContentAlignment="Center" Text="bin;obj;.git;.vs;node_modules;*.tmp;*.user;*.suo" ToolTip="Semicolon-separated folder or extension exclusions"/></Grid></Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Compare Git branches" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="The tool fetches remote references before comparing; it never changes your checked-out branch." Foreground="#4B5563" Margin="0,4,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Base branch" Foreground="#4B5563" Margin="0,0,0,6"/><ComboBox x:Name="BaseBranch" Height="38" IsEditable="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Compare branch" Foreground="#4B5563" Margin="0,0,0,6"/><ComboBox x:Name="CompareBranch" Height="38" IsEditable="True"/></StackPanel><Button x:Name="SyncBranchesButton" Grid.Column="4" Content="↻  Sync branches" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="38"/></Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><CheckBox x:Name="IncludeWorkspace" Content="Include staged, unstaged, and untracked workspace changes" IsChecked="True" VerticalAlignment="Center" Foreground="#4B5563"/><Button x:Name="CompareButton" Grid.Column="1" Content="⇄  Sync and compare" Style="{StaticResource PrimaryButton}" Height="42"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Add files manually" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="Type or browse a folder. Large folders are scanned in the background." Foreground="#4B5563" Margin="0,4,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="105"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="ManualFolderPath" Height="38" VerticalContentAlignment="Center"/><Button x:Name="BrowseFolderButton" Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}"/><Button x:Name="AddFolderButton" Grid.Column="4" Content="＋ Add folder" Style="{StaticResource SecondaryButton}"/><Button x:Name="ChooseFilesButton" Grid.Column="6" Content="＋ Choose files" Style="{StaticResource SecondaryButton}"/></Grid><ProgressBar x:Name="CollectProgress" Height="5" Margin="0,16,0,0" Visibility="Collapsed" IsIndeterminate="True"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="2. Review"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Review delivery files" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="Use the checkboxes to include only files that belong in this package." Foreground="#4B5563" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TOTAL FILES" Foreground="#9CA3AF" FontSize="11"/><TextBlock x:Name="TotalFilesText" Text="0" Foreground="#0A7CFF" FontSize="19" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SELECTED" Foreground="#9CA3AF" FontSize="11"/><TextBlock x:Name="SelectedFilesText" Text="0" Foreground="#0A7CFF" FontSize="19" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="SQL FILES" Foreground="#9CA3AF" FontSize="11"/><TextBlock x:Name="SqlFilesText" Text="0" Foreground="#0A7CFF" FontSize="19" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="TOTAL SIZE" Foreground="#9CA3AF" FontSize="11"/><TextBlock x:Name="TotalSizeText" Text="0 B" Foreground="#0A7CFF" FontSize="19" FontWeight="SemiBold"/></StackPanel></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Paste file list" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="Click below and press Ctrl+V. One path per line; absolute paths or paths relative to Source are supported." Foreground="#4B5563" Margin="0,4,0,10"/><TextBox x:Name="PasteInput" Height="58" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Background="#FFFEF5"/></StackPanel></Border>
        <DataGrid x:Name="FileGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"><DataGrid.Columns><DataGridCheckBoxColumn Header="" Binding="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42"/><DataGridTextColumn Header="SOURCE FILE" Binding="{Binding Source}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="DELIVERY PATH" Binding="{Binding Relative}" Width="280" IsReadOnly="True"/><DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="100" IsReadOnly="True"/><DataGridTemplateColumn Header="STATUS" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SelectAllButton" Content="Select all" Style="{StaticResource SecondaryButton}"/><Button x:Name="ClearSelectionButton" Grid.Column="2" Content="Clear selection" Style="{StaticResource SecondaryButton}"/><Button x:Name="RemoveSelectedButton" Grid.Column="4" Content="Remove selected" Style="{StaticResource SecondaryButton}"/><Button x:Name="ContinueButton" Grid.Column="6" Content="Continue to delivery  →" Style="{StaticResource PrimaryButton}"/></Grid>
      </Grid></TabItem>
      <TabItem x:Name="DeliverTab" Header="3. Deliver" ToolTip="Select at least one file in Review first."><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Delivery destination" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="145"/><ColumnDefinition Width="12"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationPath" Height="38" VerticalContentAlignment="Center"/><Button x:Name="ChooseDestinationButton" Grid.Column="2" Content="▣  Choose folder" Style="{StaticResource SecondaryButton}"/><Button x:Name="OpenDestinationButton" Grid.Column="4" Content="↗  Open folder" Style="{StaticResource SecondaryButton}" IsEnabled="False"/></Grid></Grid></Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Delivery options" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="16"/><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="DuplicateMode" Height="38" SelectedIndex="0"><ComboBoxItem Content="Skip duplicates"/><ComboBoxItem Content="Overwrite duplicates"/><ComboBoxItem Content="Rename automatically"/></ComboBox><CheckBox x:Name="VerifyHash" Grid.Column="2" Content="Verify SHA-256" VerticalAlignment="Center" Foreground="#4B5563"/><CheckBox x:Name="CreateRunScript" Grid.Column="4" Content="Create runscript.sql" IsChecked="True" VerticalAlignment="Center" Foreground="#4B5563"/></Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ConfigureSqlButton" Content="Configure SQL*Plus" Style="{StaticResource SecondaryButton}"/><TextBlock Grid.Column="2" Text="runscript.sql never contains the password; SQL*Plus prompts when it runs." Foreground="#4B5563" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="DeliverySummary" Text="No files selected." FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/><ProgressBar x:Name="DeliveryProgress" Height="8" Margin="0,16,0,0"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StartDeliveryButton" Content="▶  Start delivery" Style="{StaticResource PrimaryButton}" Height="42"/><Button x:Name="CancelDeliveryButton" Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}" IsEnabled="False" Height="42"/><TextBlock x:Name="DeliveryStatus" Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#4B5563" Text="Ready"/></Grid></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="Delivery Copy is portable: Windows PowerShell 5.1 is enough. Git is only needed for branch comparison." Foreground="#9CA3AF"/>
  </Grid>
</Window>
